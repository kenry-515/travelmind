# =============================================================
# TravelMind Agent — Environment Variables
# Copy to backend/.env and fill in your actual keys
# =============================================================

# --- App ---
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- LLM (DeepSeek) ---
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT=60
# deepseek-chat 已于 2026-07-24 弃用，对应 deepseek-v4-flash 非思考模式
LLM_MODEL=deepseek-v4-flash
LLM_MAX_CONCURRENT=4
LLM_STRUCTURED_TIMEOUT_MULT=1.5

# --- Vision (Kimi) ---
VISION_PROVIDER=kimi
MOONSHOT_API_KEY=sk-xxx
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
VISION_MODEL=kimi-k2.6
VISION_TIMEOUT=60
# 备用视觉服务（未启用）
QWEN_API_KEY=sk-xxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TENCENT_SECRET_ID=xxx
TENCENT_SECRET_KEY=xxx

# --- Maps (Amap / 高德) ---
# 可选：留空则 POI 验证与路径距离回落到 KB 坐标 + 名称匹配（is_amap_available() 优雅降级）
# 这月免费额度用完时直接留空即可，后端会自动走兜底逻辑
AMAP_API_KEY=
AMAP_SIGN_KEY=

# --- Weather ---
# 免费 API，无需 key
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/travelmind_db
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/travelmind_db

# --- Session Store ---
# memory: 进程内，重启丢（开发/测试）
# sqlite:  dev 默认（文件持久化，零额外依赖）
# redis:   多 worker / 重启保会话
SESSION_STORE=memory
SESSION_SQLITE_PATH=./.sessions/sessions.db
REDIS_URL=redis://localhost:6379/0

# --- Chroma ---
CHROMA_PERSIST_DIR=./chroma_data