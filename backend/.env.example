# Backend .env — copy to .env and fill in actual keys
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

VISION_PROVIDER=kimi
MOONSHOT_API_KEY=sk-xxx
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
VISION_MODEL=kimi-k2.6
VISION_TIMEOUT=60
# 备选视觉服务（未启用）
QWEN_API_KEY=sk-xxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TENCENT_SECRET_ID=xxx
TENCENT_SECRET_KEY=xxx

AMAP_API_KEY=xxx
AMAP_SIGN_KEY=xxx  # 数字签名私钥 (optional, only if signing is enabled in Amap console)

OPEN_METEO_BASE_URL=https://api.open-meteo.com

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/travelmind_db
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/travelmind_db

SESSION_STORE=memory  # memory | redis（多 worker / 重启保会话需设为 redis）
REDIS_URL=redis://localhost:6379/0

CHROMA_PERSIST_DIR=./chroma_data

APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
