# =============================================================
# TravelMind Agent — Environment Variables
# Copy to backend/.env and fill in your actual keys
# =============================================================

# --- LLM Provider ---
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Vision Provider ---
VISION_PROVIDER=qwen
QWEN_API_KEY=sk-xxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TENCENT_SECRET_ID=xxx
TENCENT_SECRET_KEY=xxx

# --- Map Providers ---
AMAP_API_KEY=xxx
BAIDU_MAP_AK=xxx

# --- Weather ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/travelmind_db
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/travelmind_db

# --- Chroma ---
CHROMA_PERSIST_DIR=./chroma_data

# --- App ---
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
